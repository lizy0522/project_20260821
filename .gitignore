.ipynb_checkpoints/

# Local environments and secrets
.venv/
.conda/
venv/
env/
.env
.env.*
!.env.example
*.local
*.key
*.pem

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ----------------------------------------------------------------------
# Scientific data
# ----------------------------------------------------------------------

# Keep actual raw scientific data local, but preserve the canonical
# scenario-level directory skeleton with explicit .gitkeep exceptions.
data/raw/**
!data/raw/.gitkeep
!data/raw/scenario_1/
!data/raw/scenario_1/.gitkeep
!data/raw/scenario_2/
!data/raw/scenario_2/.gitkeep

# Keep reusable processed datasets local, but preserve the canonical
# scenario-level directory skeleton.
data/processed/**
!data/processed/.gitkeep
!data/processed/scenario_1/
!data/processed/scenario_1/.gitkeep
!data/processed/scenario_2/
!data/processed/scenario_2/.gitkeep

