# Python cache and compiled files
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environments and secrets
.venv/
.conda/
.env
*.local

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Raw and processed data are local by default
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Code-generated results are local-only
results/

# Work logs and handoff documents are reviewable project records and may be committed

# Common generated binary and inspection artifacts
*.npz
*.npy
*.mat
*.pkl
*.pickle
*.joblib
*.xlsx
*.xls
*.parquet
*.h5
*.hdf5
*.inspect.ndjson
*.png
*.jpg
*.jpeg
*.pdf
*.svg
